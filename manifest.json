{
  "manifest_version": 3,
  "name": "Doc-Inspector-HP",
  "description": "Offline agent writing assistant for HotelPlanner with optional grammar suggestions and approved abbreviations.",
  "version": "1.5.7",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Doc-Inspector-HP"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://www.hotelplanner.com/*",
        "https://hotelplanner.com/*"
      ],
      "js": [
        "inspector.js"
      ],
      "css": [
        "inspector.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "harper-worker.js"
      ],
      "matches": [
        "https://www.hotelplanner.com/*",
        "https://hotelplanner.com/*"
      ]
    }
  ]
}